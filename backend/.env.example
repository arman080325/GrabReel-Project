# ─────────────────────────────────────────────
#  GrabReel – Environment Variables
#  Copy this to .env and fill in your real keys
#  NEVER commit .env to Git
# ─────────────────────────────────────────────


# Your RapidAPI key (from the RapidAPI dashboard)
RAPIDAPI_KEY=your-rapidapi-key-here

# RapidAPI host for Instagram API - Media Downloader
RAPIDAPI_HOST=instagram-downloader-download-instagram-stories-videos4.p.rapidapi.com
RAPIDAPI_YT_HOST=youtube-video-and-shorts-downloader.p.rapidapi.com

# Port the server runs on locally (Render sets this automatically)
PORT=5000

# Your frontend URL for CORS (change to your live domain when deployed)
FRONTEND_URL=http://127.0.0.1:5500